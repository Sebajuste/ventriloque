# Ce qui se rebatit
src-tauri/target/
src-tauri/gen/schemas/
ui/dist/
dist/

# Sans barre oblique de tete : n'importe ou dans l'arbre. Il y a maintenant un `package.json` a
# la racine en plus de celui de `ui`, et une regle par emplacement en aurait manque un.
node_modules/
tools/target/
tools/extract-casc/obj/
tools/extract-casc/*.exe

# Le fabricant se rebatit depuis `tools/pack-builder` a chaque compilation : le versionner
# ferait entrer 4,5 Mo de binaire dans l'historique a chaque build.
src-tauri/binaries/pack-builder.exe
tools/__pycache__/

# Les reglages du moteur, ecrits par l'application a chaque "Appliquer". Ils vivaient sous une
# cle de ventriloque.json, qui est versionne : regler une temperature en seance faisait alors
# apparaitre le depot comme modifie, et le reglage d'un poste partait dans un commit.
/tuning.json

# Les recettes INSTALLEES, posees la par un paquet. Les sources sont dans `tools/recipes/`.
/recipes/

# Ce qui ne se publie pas : un demi-gigaoctet de modeles sous liste d'autorisation, les
# references de voix tirees des jeux du joueur, et le cache de clonage qui se refait seul.
/models/
/voices/
/packs-a-distribuer/
/engine/
/.build/
diag.log

# Les memes dossiers sous leurs noms d'avant. Ventriloque les renomme au demarrage, mais une
# copie plus ancienne posee ici ne doit pas apparaitre entre-temps comme du contenu a versionner.
/voix/
/pnj/
/modeles/
/recettes/
/moteur/
/.fabrique/

# CascLib est un depot tiers clone sur place — il porte 91 Mo de `listfile`. Il se recupere, il
# ne se versionne pas ici. Le `build.rs` du fabricant dit comment le cloner s'il manque.
tools/pack-builder/vendor/
