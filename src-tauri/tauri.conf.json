{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ventriloque",
  "version": "0.1.0",
  "identifier": "fr.sebajuste.ventriloque",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeBuildCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/prepare.ps1",
    "beforeDevCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/prepare.ps1 -Fabricant && npm --prefix ui run dev",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Ventriloque",
        "width": 1080,
        "height": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/pocket-tts"
    ],
    "resources": [
      "binaries/onnxruntime.dll"
    ],
    "publisher": "Sebajuste",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIyNTg4RjJENTAyQjQxOTIKUldTU1FTdFFMWTlZSW5GcFJsZ0FNSUJwaXA1TEtvWDh3TncyU1lGZk95NnJCY0c5SEdIeSs4aEIK",
      "endpoints": [
        "https://github.com/Sebajuste/ventriloque/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
